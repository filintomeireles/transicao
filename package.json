{
  "name": "transicao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx tools/simulate.ts",
    "android": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.2.0",
    "@capacitor/core": "7.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.2.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "happy-dom": "15.11.7",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
